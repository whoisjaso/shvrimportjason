{
  "manifest_version": 3,
  "name": "HCP Job Costing Export for SHVR",
  "short_name": "Job Costing Export",
  "version": "1.0.0",
  "description": "Download every Housecall Pro job with its materials and miscellaneous costs as spreadsheets.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "host_permissions": ["https://api.housecallpro.com/*", "https://pro.housecallpro.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Export job costs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
